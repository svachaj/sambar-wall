#!/bin/sh
# Runs the Playwright e2e suite before pushing (enabled by `make install-hooks`).
# Skips pushes that only change documentation. Skip it once with: SKIP_E2E=1 git push  (or git push --no-verify)

if [ "$SKIP_E2E" = "1" ]; then
  echo "pre-push: SKIP_E2E=1, skipping e2e tests"
  exit 0
fi

repo=$(git rev-parse --show-toplevel)
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
changed=""

# stdin: <local ref> <local sha> <remote ref> <remote sha> per pushed ref
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a remote branch

  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base "$local_sha" origin/HEAD 2>/dev/null)
  elif git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    base=$remote_sha
  else
    base="" # remote has commits we don't know (e.g. force push): be safe and test
  fi

  if [ -z "$base" ]; then
    changed="$changed unknown"
  else
    changed="$changed $(git diff --name-only "$base" "$local_sha")"
  fi
done

code_changes=$(printf '%s\n' $changed | grep -v -E '(\.md|^LICENSE)$' | grep -c .)
if [ "$code_changes" -eq 0 ]; then
  echo "pre-push: no code changes, skipping e2e tests"
  exit 0
fi

if [ ! -d "$repo/e2e/node_modules" ] || [ ! -f "$repo/e2e/.env" ]; then
  echo "pre-push: e2e suite is not set up. Run 'make e2e-install' and create e2e/.env (see README), or push with SKIP_E2E=1." >&2
  exit 1
fi

echo "pre-push: running e2e tests (skip once with SKIP_E2E=1 git push)..."
cd "$repo" && make e2e || {
  echo "pre-push: e2e tests failed, push aborted. Report: make e2e-report" >&2
  exit 1
}
