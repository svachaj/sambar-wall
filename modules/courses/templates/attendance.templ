package courses

import (
	types "github.com/svachaj/sambar-wall/db/types"
	"github.com/svachaj/sambar-wall/modules/layouts"
	"github.com/svachaj/sambar-wall/utils"
)

templ AttendancePage(courseOptions []types.Course, rows []types.AttendanceSheetRow, selectedCourseID int, lessonDate string, isAdmin bool, canSeeVisitors bool, toast templ.Component) {
	@layouts.BaseLayout(true, isAdmin, canSeeVisitors) {
		<div class="w-full flex flex-col items-center justify-center px-2">
			<div class="w-full max-w-5xl border border-neutral-600 shadow-xl rounded-xl bg-neutral-900 mb-10">
				<div class="py-3 bg-slate-800 rounded-t-xl sticky top-[76px] z-10 flex flex-row items-center justify-between">
					<h2 class="px-4 sm:text-xl text-lg text-center font-semibold leading-7 text-white sm:px-6 lg:px-8">Docházka dětí</h2>
					<form
						hx-get="/dochazka-export-init"
						hx-trigger="click"
						hx-swap="afterend"
						hx-include="[name='courseId'],[name='lessonDate']"
						class="mr-4"
					>
						<button class="rounded-md bg-primary-600 px-3 py-2 text-sm font-semibold text-white hover:bg-primary-400">Export XLSX</button>
					</form>
				</div>
				<form method="GET" action="/dochazka" class="p-3 flex flex-col md:flex-row gap-3 items-start md:items-end">
					<div class="flex flex-col gap-1 w-full md:w-80">
						<label class="text-sm text-white" for="courseId">Kurz</label>
						<select id="courseId" name="courseId" class="p-2 bg-neutral-800 text-white rounded border border-neutral-600" onchange="this.form.submit()">
							for _, course := range courseOptions {
								<option value={ utils.StringFromInt(course.ID) } selected?={ selectedCourseID == course.ID }>{ course.Name + " - " + course.Days + " (" + course.TimeFrom.Format("15:04") + "-" + course.TimeTo.Format("15:04") + ")" }</option>
							}
						</select>
					</div>
					<div class="flex flex-col gap-1 w-full md:w-52">
						<label class="text-sm text-white" for="lessonDate">Datum lekce</label>
						<input id="lessonDate" type="date" name="lessonDate" value={ lessonDate } class="p-2 bg-neutral-800 text-white rounded border border-neutral-600" onchange="this.form.submit()"/>
					</div>
				</form>
				<div class="overflow-x-auto" id="attendanceTable">
					<table class="mt-2 w-full whitespace-nowrap text-left">
						<thead class="lg:border-b border-0 border-white/20 text-sm leading-6 text-white">
							<tr>
								<th scope="col" class="py-2 px-4 font-semibold text-center">Účastník</th>
								<th scope="col" class="py-2 px-4 font-semibold text-center">Rodič</th>
								<th scope="col" class="py-2 px-4 font-semibold text-center">Docházka</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-white/20">
							for _, row := range rows {
								<tr class="hover:bg-slate-800">
									<td class="py-4 px-4 text-sm font-medium leading-6 text-white text-center">{ row.LastName + " " + row.FirstName }</td>
									<td class="py-4 px-4 text-sm font-medium leading-6 text-white text-center">{ utils.StringFromStringPointer(row.ParentName) }</td>
									<td class="py-4 px-4 text-sm font-medium leading-6 text-white text-center">
										@AttendanceToggle(row.Present, utils.StringFromInt(row.ApplicationFormID), row.CourseID, lessonDate)
									</td>
								</tr>
							}
							if len(rows) == 0 {
								<tr>
									<td colspan="3" class="py-6 px-4 text-center text-sm text-gray-300">Pro vybraný kurz a datum nejsou žádné aktivní přihlášky.</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
		<form id="download-attendance-form" action="/dochazka-export" method="GET" style="display:none"></form>
		if toast != nil {
			@toast
		}
	}
}

templ AttendanceToggle(present bool, applicationID string, courseID int, lessonDate string) {
	<div
		class="inline-flex items-center rounded-md px-4 py-2 cursor-pointer text-sm font-semibold underline-offset-2"
		hx-put={ "/dochazka/" + applicationID + "?present=" + utils.StringifyBool(!present) + "&courseId=" + utils.StringFromInt(courseID) + "&lessonDate=" + lessonDate }
		hx-trigger="click"
		hx-swap="outerHTML"
	>
		if present {
			<span class="text-green-500 hover:underline">Byl</span>
		} else {
			<span class="text-red-500 hover:underline">Nebyl</span>
		}
	</div>
}

templ AttendanceToggleWithToast(present bool, applicationID string, courseID int, lessonDate string, toast templ.Component) {
	@AttendanceToggle(present, applicationID, courseID, lessonDate)
	if toast != nil {
		@toast
	}
}
