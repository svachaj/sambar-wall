package courses

import (
	types "github.com/svachaj/sambar-wall/db/types"
	"github.com/svachaj/sambar-wall/modules/courses/models"
	"github.com/svachaj/sambar-wall/modules/layouts"
	"github.com/svachaj/sambar-wall/utils"
)

templ AttendancePage(m models.AttendancePageModel, isAdmin bool, canSeeVisitors bool, toast templ.Component) {
	@layouts.BaseLayout(true, isAdmin, canSeeVisitors) {
		<div class="w-full flex flex-col items-center justify-center px-2">
			<div class="w-full max-w-5xl border border-neutral-600 shadow-xl rounded-xl bg-neutral-900 mb-10">
				<div class="py-3 bg-slate-800 rounded-t-xl sticky top-[76px] z-10 flex flex-row items-center justify-between">
					<h2 class="px-4 sm:text-xl text-lg text-center font-semibold leading-7 text-white sm:px-6 lg:px-8">Docházka dětí</h2>
					if m.SelectedCourseID > 0 {
						<a
							hx-boost="false"
							href={ templ.SafeURL("/dochazka-export?courseId=" + utils.StringFromInt(m.SelectedCourseID) + "&lessonDate=" + m.LessonDate) }
							class="mr-4 rounded-md bg-primary-600 px-3 py-2 text-sm font-semibold text-white hover:bg-primary-400"
						>Export lekce XLSX</a>
					}
				</div>
				<div class="p-3 flex flex-col md:flex-row gap-3 items-start md:items-end">
					<form method="GET" action="/dochazka" class="flex flex-col gap-1 w-full md:w-auto">
						<label class="text-sm text-white" for="lessonDate">Datum lekce</label>
						<div class="flex flex-row items-center gap-2">
							if m.SelectedCourseID > 0 {
								<a
									href={ templ.SafeURL("/dochazka?courseId=" + utils.StringFromInt(m.SelectedCourseID) + "&lessonDate=" + m.PrevLessonDate) }
									title="O týden zpět"
									class="px-3 py-2 rounded border border-neutral-600 bg-neutral-800 text-white hover:bg-neutral-700"
								>◀</a>
							}
							<input id="lessonDate" type="date" name="lessonDate" value={ m.LessonDate } class="p-2 bg-neutral-800 text-white rounded border border-neutral-600 cursor-pointer hover:border-neutral-400" onchange="this.form.submit()"/>
							if m.SelectedCourseID > 0 {
								<a
									href={ templ.SafeURL("/dochazka?courseId=" + utils.StringFromInt(m.SelectedCourseID) + "&lessonDate=" + m.NextLessonDate) }
									title="O týden dopředu"
									class="px-3 py-2 rounded border border-neutral-600 bg-neutral-800 text-white hover:bg-neutral-700"
								>▶</a>
							}
						</div>
						<div class="text-sm font-semibold text-primary-400">{ m.LessonDateLabel }</div>
					</form>
					<form method="GET" action="/dochazka" class="flex flex-col gap-1 w-full ">
						<input type="hidden" name="lessonDate" value={ m.LessonDate }/>
						<label class="text-sm text-white" for="courseId">Kurz</label>
						<div class="relative">
							<select id="courseId" name="courseId" class="w-full appearance-none bg-none p-2 pr-10 bg-neutral-800 text-white rounded border border-neutral-600 cursor-pointer hover:border-neutral-400" onchange="this.form.submit()">
								if m.SelectedCourseID == 0 {
									<option value="" selected>— vyberte kurz —</option>
								}
								if len(m.DayCourses) > 0 {
									<optgroup label="Kurzy v tento den">
										for _, course := range m.DayCourses {
											@attendanceCourseOption(course, m.SelectedCourseID)
										}
									</optgroup>
								}
								if len(m.OtherCourses) > 0 {
									<optgroup label="Ostatní kurzy">
										for _, course := range m.OtherCourses {
											@attendanceCourseOption(course, m.SelectedCourseID)
										}
									</optgroup>
								}
							</select>
							<svg class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 h-5 w-5 text-gray-200" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" d="m6 8 4 4 4-4"></path>
							</svg>
						</div>
						<div class="text-sm text-gray-400 invisible">&nbsp;</div>
					</form>
				</div>
				if m.DayMismatch {
					<div class="mx-3 mb-2 rounded-md border border-yellow-500 bg-yellow-900/40 px-4 py-3 text-sm text-yellow-200">
						<span class="font-bold">Pozor:</span> vybraný kurz probíhá v den „{ m.SelectedCourseDays }“, ale zvolené datum je { m.LessonDateLabel }. Opravdu zapisujete správné datum?
					</div>
				}
				if m.SelectedCourseID == 0 {
					<div class="mx-3 mb-4 py-6 px-4 text-center text-sm text-gray-300">
						if len(m.DayCourses) == 0 {
							V tento den neprobíhá žádný kurz. Zvolte jiné datum nebo vyberte kurz ze seznamu.
						} else {
							Vyberte kurz.
						}
					</div>
				} else {
					<div class="overflow-x-auto" id="attendanceTable">
						<table class="mt-2 w-full whitespace-nowrap text-left">
							<thead class="lg:border-b border-0 border-white/20 text-sm leading-6 text-white">
								<tr>
									<th scope="col" class="hidden py-2 px-4 font-semibold text-center lg:table-cell">Účastník</th>
									<th scope="col" class="hidden py-2 px-4 font-semibold text-center lg:table-cell">Rodič</th>
									<th scope="col" class="hidden py-2 px-4 font-semibold text-center lg:table-cell">Telefon rodiče</th>
									<th scope="col" class="hidden py-2 px-4 font-semibold text-center lg:table-cell">Zdravotní stav</th>
									<th scope="col" class="hidden py-2 px-4 font-semibold text-center lg:table-cell">Docházka</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-white/20">
								for _, row := range m.Rows {
									<tr class="hover:bg-slate-800">
										<td class="lg:hidden table-cell py-4 px-4 w-full text-white text-sm whitespace-normal">
											<div class="flex flex-col gap-1">
												<div class="text-base font-bold leading-6 text-white break-words">{ row.LastName + " " + row.FirstName }</div>
												<div class="text-xs font-medium leading-5 text-gray-300 break-words"><span class="text-gray-400">Rodič:&nbsp;</span>{ utils.StringFromStringPointer(row.ParentName) }</div>
												<div class="text-xs font-medium leading-5 text-gray-300 break-words"><span class="text-gray-400">Telefon:&nbsp;</span>{ utils.StringFromStringPointer(row.ParentPhone) }</div>
												<div class="text-xs font-medium leading-5 text-gray-300 break-words whitespace-pre-line max-h-24 overflow-y-auto pr-1"><span class="text-gray-400">Zdravotní stav:&nbsp;</span>{ utils.StringFromStringPointer(row.HealthState) }</div>
												<div class="pt-2 mt-1 border-t border-white/10">
													<div class="text-xs font-medium text-gray-400 mb-1">Docházka</div>
													@AttendanceButtons(models.AttendanceStatus(row.HasRecord, row.Present), utils.StringFromInt(row.ApplicationFormID), row.CourseID, m.LessonDate)
												</div>
											</div>
										</td>
										<td class="hidden py-4 px-4 text-sm font-medium leading-6 text-white text-center lg:table-cell">{ row.LastName + " " + row.FirstName }</td>
										<td class="hidden py-4 px-4 text-sm font-medium leading-6 text-white text-center lg:table-cell">{ utils.StringFromStringPointer(row.ParentName) }</td>
										<td class="hidden py-4 px-4 text-sm font-medium leading-6 text-white text-center lg:table-cell">{ utils.StringFromStringPointer(row.ParentPhone) }</td>
										<td class="hidden py-4 px-4 text-sm font-medium leading-6 text-white text-center lg:table-cell">{ utils.StringFromStringPointer(row.HealthState) }</td>
										<td class="hidden py-4 px-4 text-sm font-medium leading-6 text-white text-center lg:table-cell">
											@AttendanceButtons(models.AttendanceStatus(row.HasRecord, row.Present), utils.StringFromInt(row.ApplicationFormID), row.CourseID, m.LessonDate)
										</td>
									</tr>
								}
								if len(m.Rows) == 0 {
									<tr>
										<td colspan="5" class="py-6 px-4 text-center text-sm text-gray-300">Pro vybraný kurz a datum nejsou žádné aktivní přihlášky.</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
			<form method="GET" action="/dochazka-export-vse" hx-boost="false" class="m-3 mt-3 p-3 rounded-md border border-neutral-700 flex flex-col md:flex-row gap-3 items-start md:items-end">
				<div class="text-sm font-semibold text-white md:self-center md:mr-2">Celková docházka</div>
				<div class="flex flex-col gap-1">
					<label class="text-sm text-white" for="dateFrom">Od</label>
					<input id="dateFrom" type="date" name="dateFrom" value={ m.ExportDateFrom } required class="p-2 bg-neutral-800 text-white rounded border border-neutral-600 cursor-pointer hover:border-neutral-400"/>
				</div>
				<div class="flex flex-col gap-1">
					<label class="text-sm text-white" for="dateTo">Do</label>
					<input id="dateTo" type="date" name="dateTo" value={ m.ExportDateTo } required class="p-2 bg-neutral-800 text-white rounded border border-neutral-600 cursor-pointer hover:border-neutral-400"/>
				</div>
				<button type="submit" class="rounded-md bg-primary-600 px-3 py-2 text-sm font-semibold text-white hover:bg-primary-400">Export vše XLSX</button>
			</form>
		</div>
		if toast != nil {
			@toast
		}
	}
}

templ attendanceCourseOption(course types.Course, selectedCourseID int) {
	<option value={ utils.StringFromInt(course.ID) } selected?={ selectedCourseID == course.ID }>{ course.Days + " " + course.TimeFrom.Format("15:04") + "–" + course.TimeTo.Format("15:04") + " – " + course.Name }</option>
}

templ AttendanceButtons(status string, applicationID string, courseID int, lessonDate string) {
	<div class="inline-flex rounded-md border border-neutral-600 overflow-hidden text-sm font-semibold">
		@attendanceButton(models.ATTENDANCE_STATUS_UNSET, status, applicationID, courseID, lessonDate, "bg-neutral-500 text-white")
		@attendanceButton(models.ATTENDANCE_STATUS_PRESENT, status, applicationID, courseID, lessonDate, "bg-green-600 text-white")
		@attendanceButton(models.ATTENDANCE_STATUS_ABSENT, status, applicationID, courseID, lessonDate, "bg-red-600 text-white")
	</div>
}

templ attendanceButton(target string, current string, applicationID string, courseID int, lessonDate string, activeClass string) {
	if target == current {
		<span class={ "px-4 py-2 cursor-default", activeClass }>{ models.AttendanceStatusLabel(target) }</span>
	} else {
		<button
			type="button"
			class="px-4 py-2 bg-neutral-800 text-gray-300 hover:bg-neutral-700 hover:text-white"
			hx-put={ "/dochazka/" + applicationID + "?status=" + target + "&courseId=" + utils.StringFromInt(courseID) + "&lessonDate=" + lessonDate }
			hx-target="closest div"
			hx-swap="outerHTML"
		>{ models.AttendanceStatusLabel(target) }</button>
	}
}

templ AttendanceButtonsWithToast(status string, applicationID string, courseID int, lessonDate string, toast templ.Component) {
	@AttendanceButtons(status, applicationID, courseID, lessonDate)
	if toast != nil {
		@toast
	}
}
