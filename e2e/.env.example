# The e2e suite reads the database settings from the repo-root .env (same as the app) and writes
# test data into that database. It refuses to run unless DB_NAME equals this value.
E2E_ALLOW_DB=SAMBAR_TEST

# Port for the app started by Playwright (keeps clear of air on 5500/5511).
# E2E_PORT=5599

# How long a run waits for another e2e run (any machine) to release the shared-DB lock.
# E2E_LOCK_WAIT_MINUTES=5

# Set to 1 to keep the e2e rows after the run for debugging (purged again on the next run).
# E2E_KEEP_DATA=1
